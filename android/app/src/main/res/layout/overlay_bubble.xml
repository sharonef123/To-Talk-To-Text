<?xml version="1.0" encoding="utf-8"?>
<!--
  Single root the service adds to the WindowManager. The compact bubble is
  the ONLY persistent control - a single tap starts/stops recording right
  there (the whole circle glows red while listening), a long-press opens the
  settings panel (language + history + close), and dragging moves it. Only
  one of {compactBubble, settingsPanel} is VISIBLE at a time; the other is
  GONE (not INVISIBLE) so the root's wrap_content size - and so the overlay
  window's actual touchable footprint - shrinks back to just the bubble
  whenever the panel isn't open.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/compactBubble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bubble_circle_bg"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/compactIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/bubble_compact_desc" />
    </FrameLayout>

    <!-- Settings panel: language picker + transcript history + close bubble. -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:elevation="8dp"
        android:padding="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/languageSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="13sp"
            android:textColor="@color/ttt_text_primary"
            android:textColorHint="@color/ttt_text_muted"
            android:hint="@string/search_languages_hint"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="8dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/languageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/ttt_surface_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/history_title"
                android:textColor="@color/ttt_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/historyClearButton"
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_history_clear"
                    android:contentDescription="@string/clear_history_desc" />
            </FrameLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="4dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/ttt_surface_border" />

        <TextView
            android:id="@+id/closeBubbleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/close_bubble_desc"
            android:textColor="@color/ttt_recording"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
